@{
    ViewData["Title"] = "Kan ik een korte broek aan?";
    var message = "Kan ik vandaag een korte broek aan?";
}
<div class="container py-5">
    <div class="row justify-content-center align-items-center">
        <div class="col-12 col-md-8 col-lg-6 text-center">
            <img src="~/images/kortebroek-question.png" alt="Korte Broek" class="img-fluid mb-4" style="max-width: 200px;" />
            <h1 class="display-4 fw-bold mb-3">@message</h1>
            <p class="lead">Check het weer en ontdek of je vandaag een korte broek aan kunt!</p>
        </div>
    </div>
</div>
